<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    tools:context=".fragment.main.CategoryFragment">


    <LinearLayout
        android:id="@+id/layout_category_header"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_52"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_32"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_category_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ripple"
            android:clickable="true"
            android:contentDescription="@string/fragment_landing_ic_menu"
            android:focusable="true"
            android:padding="@dimen/dp_8"
            android:scaleType="centerInside"
            android:src="@drawable/ic_landing_menu"
            app:tint="?attr/colorPrimary" />

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_1"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_category_search"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:background="@drawable/bg_ripple"
            android:clickable="true"
            android:contentDescription="@string/fragment_landing_ic_search"
            android:focusable="true"
            android:padding="@dimen/dp_8"
            android:scaleType="centerInside"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/btn_category_cart"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:background="@drawable/bg_ripple"
            android:clickable="true"
            android:contentDescription="@string/fragment_landing_ic_cart"
            android:focusable="true"
            android:padding="@dimen/dp_8"
            android:scaleType="centerInside"
            android:src="@drawable/ic_landing_cart"
            app:tint="?attr/colorPrimary" />

    </LinearLayout>

    <View
        android:id="@+id/layout_category_headerline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_2"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:layout_marginTop="-10dp"
        android:background="@drawable/header_divider"
        android:foreground="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="@+id/layout_category_header"
        app:layout_constraintStart_toStartOf="@+id/layout_category_header"
        app:layout_constraintTop_toBottomOf="@+id/layout_category_header" />

    <TextView
        android:id="@+id/tvCategoryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/fragment_category_title"
        android:textColor="?attr/colorPrimary"
        android:textSize="?attr/text_size_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_category_headerline" />

    <LinearLayout
        android:id="@+id/layoutLargeCategorySelector"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_44"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_14"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCategoryTitle">

        <TextView
            android:id="@+id/tvFurniture"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/dp_6"
            android:layout_weight="1"
            android:background="@drawable/bg_large_category_selected"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/bg_ripple"
            android:gravity="center"
            android:singleLine="true"
            android:text="Furniture"
            android:textColor="@color/white"
            android:textSize="?attr/text_size_14" />

        <TextView
            android:id="@+id/tvCarItem"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_weight="1"
            android:background="@drawable/bg_large_category_unselected"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/bg_ripple"
            android:gravity="center"
            android:singleLine="true"
            android:text="CarItem"
            android:textColor="@color/white"
            android:textSize="?attr/text_size_14" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMainCategories"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_22"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/dp_110"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutLargeCategorySelector" />


</androidx.constraintlayout.widget.ConstraintLayout>