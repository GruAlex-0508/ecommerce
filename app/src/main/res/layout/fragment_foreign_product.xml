<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollForeignProduct"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/dp_110"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dp_20"
            android:paddingTop="@dimen/dp_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_14"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnForeignMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ripple"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:padding="@dimen/dp_8"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_landing_menu"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Foreign Order"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="?attr/text_size_20"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="@dimen/dp_44"
                    android:layout_height="@dimen/dp_44"
                    android:background="@color/transparent"
                    android:contentDescription="@null"
                    android:foreground="@drawable/bg_ripple"
                    android:padding="@dimen/dp_8"
                    android:src="@drawable/ic_refresh"
                    app:tint="?attr/colorPrimary" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_2"
                android:layout_marginHorizontal="@dimen/dp_4"
                android:layout_marginTop="-8dp"
                android:background="?attr/colorPrimary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginBottom="@dimen/dp_16"
                android:text="@string/foreign_order_list"
                android:textColor="?attr/colorPrimary"
                android:textSize="?attr/text_size_22" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardForeignEvent1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_170"
                android:layout_marginBottom="@dimen/dp_12"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/dp_20"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_16">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="@dimen/dp_16"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="@dimen/dp_140"
                            android:layout_height="@dimen/dp_140"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/foreign_bathroom" />

                    </com.google.android.material.card.MaterialCardView>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_20"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/foreign_event_bathroom"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="?attr/text_size_22" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_1"
                            android:layout_marginTop="@dimen/dp_2"
                            android:background="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/foreign_event_description"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="?attr/text_size_16" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_34"
                            android:layout_marginTop="@dimen/dp_8"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp_30"
                                android:background="@drawable/bg_foreign_tag"
                                android:gravity="center"
                                android:paddingHorizontal="@dimen/dp_12"
                                android:text="@string/foreign_new_tag"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="?attr/text_size_12" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp_30"
                                android:layout_marginStart="@dimen/dp_10"
                                android:background="@drawable/bg_foreign_tag"
                                android:gravity="center"
                                android:paddingHorizontal="@dimen/dp_12"
                                android:text="@string/foreign_new_tag"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="?attr/text_size_12" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp_30"
                                android:layout_marginStart="@dimen/dp_10"
                                android:background="@drawable/bg_foreign_tag"
                                android:gravity="center"
                                android:paddingHorizontal="@dimen/dp_12"
                                android:text="@string/foreign_new_tag"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="?attr/text_size_12" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardForeignEvent2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_170"
                android:layout_marginBottom="@dimen/dp_28"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/dp_20"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_16">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="@dimen/dp_16"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="@dimen/dp_140"
                            android:layout_height="@dimen/dp_140"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/foreign_bathroom" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_20"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/foreign_event_bathroom"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="?attr/text_size_22" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_1"
                            android:layout_marginTop="@dimen/dp_2"
                            android:background="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/foreign_event_description"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="?attr/text_size_16" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_34"
                            android:layout_marginTop="@dimen/dp_8"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp_30"
                                android:background="@drawable/bg_foreign_tag"
                                android:gravity="center"
                                android:paddingHorizontal="@dimen/dp_12"
                                android:text="@string/foreign_new_tag"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="?attr/text_size_12" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp_30"
                                android:layout_marginStart="@dimen/dp_10"
                                android:background="@drawable/bg_foreign_tag"
                                android:gravity="center"
                                android:paddingHorizontal="@dimen/dp_12"
                                android:text="@string/foreign_new_tag"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="?attr/text_size_12" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp_30"
                                android:layout_marginStart="@dimen/dp_10"
                                android:background="@drawable/bg_foreign_tag"
                                android:gravity="center"
                                android:paddingHorizontal="@dimen/dp_12"
                                android:text="@string/foreign_new_tag"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="?attr/text_size_12" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_215"
                android:layout_marginTop="@dimen/dp_14"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/fragment_landing_first_banner"
                    android:scaleType="fitXY"
                    android:src="@drawable/landing_banner1" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_32"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="@dimen/dp_16"
                    app:cardBackgroundColor="@color/white"
                    app:cardElevation="0dp"
                    app:shapeAppearanceOverlay="@style/RightRoundedCard"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/dp_24"
                        android:text="@string/fragment_landing_banner_chip"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="?attr/text_size_12"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_215"
                android:layout_marginTop="@dimen/dp_14"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/fragment_landing_first_banner"
                    android:scaleType="fitXY"
                    android:src="@drawable/landing_banner2" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_32"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="@dimen/dp_16"
                    app:cardBackgroundColor="@color/white"
                    app:cardElevation="0dp"
                    app:shapeAppearanceOverlay="@style/RightRoundedCard"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/dp_24"
                        android:text="@string/fragment_landing_banner_chip"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="?attr/text_size_12"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:layout_marginEnd="@dimen/dp_18"
        android:layout_marginBottom="@dimen/dp_110"
        app:cardBackgroundColor="@color/white_alpha_30"
        app:cardCornerRadius="@dimen/dp_40"
        app:cardElevation="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnForeignNew"
            android:layout_width="@dimen/dp_62"
            android:layout_height="@dimen/dp_62"
            android:layout_gravity="center"
            android:background="@drawable/bg_foreign_new"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:foreground="@drawable/bg_ripple"
            android:padding="@dimen/dp_16"
            android:src="@drawable/ic_edit"
            app:tint="@color/white" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>