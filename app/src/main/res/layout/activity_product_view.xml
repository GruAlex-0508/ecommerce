<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tool="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/productViewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/productTopArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/gradient_bg"
        tool:layout_constraintTop_toTopOf="parent"
        tool:layout_constraintBottom_toTopOf="@id/productInfoPanel"
        tool:layout_constraintStart_toStartOf="parent"
        tool:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnProductBack"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_26"
            android:src="@drawable/ic_back"
            android:contentDescription="@null"
            app:tint="?attr/colorPrimary"
            tool:layout_constraintStart_toStartOf="parent"
            tool:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_26"
            android:layout_marginEnd="@dimen/dp_20"
            android:contentDescription="@null"
            android:src="@drawable/ic_star_outline"
            app:tint="?attr/colorPrimary"
            tool:layout_constraintEnd_toEndOf="parent"
            tool:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivProduct"
            android:layout_width="@dimen/dp_290"
            android:layout_height="@dimen/dp_290"
            android:layout_marginTop="@dimen/dp_72"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            tool:layout_constraintTop_toTopOf="parent"
            tool:layout_constraintStart_toStartOf="parent"
            tool:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/layoutProductIndicators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/dp_16"
            tool:layout_constraintTop_toBottomOf="@id/ivProduct"
            tool:layout_constraintStart_toStartOf="parent"
            tool:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_10"
                android:layout_margin="@dimen/dp_6"
                android:background="@drawable/bg_indicator_small" />

            <View
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_18"
                android:layout_margin="@dimen/dp_6"
                android:background="@drawable/bg_indicator_selected" />

            <View
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_10"
                android:layout_margin="@dimen/dp_6"
                android:background="@drawable/bg_indicator_small" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/productInfoPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/dp_30"
        android:paddingTop="@dimen/dp_40"
        android:paddingBottom="@dimen/dp_110"
        android:background="@drawable/bg_product_info_panel"
        tool:layout_constraintHeight_percent="0.4"
        tool:layout_constraintBottom_toBottomOf="parent"
        tool:layout_constraintStart_toStartOf="parent"
        tool:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@null"
            android:textColor="@color/white"
            android:textSize="?attr/text_size_38"
            android:textStyle="bold"
            tool:layout_constraintStart_toStartOf="parent"
            tool:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/layoutQuantity"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_38"
            android:background="@drawable/bg_quantity"
            android:gravity="center"
            android:orientation="horizontal"
            tool:layout_constraintEnd_toEndOf="parent"
            tool:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btnMinus"
                android:layout_width="@dimen/dp_24"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/product_btn_minus"
                android:textColor="@color/white"
                android:textSize="?attr/text_size_18" />

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="@dimen/dp_24"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/product_quantity"
                android:textColor="@color/white"
                android:textSize="?attr/text_size_14" />

            <TextView
                android:id="@+id/btnPlus"
                android:layout_width="@dimen/dp_24"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/product_btn_plus"
                android:textColor="@color/white"
                android:textSize="?attr/text_size_18" />

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>