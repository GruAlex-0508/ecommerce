<?xml version="1.0" encoding="utf-8"?>
<com.chonsu.ecommerce.common.views.MIDrawerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_navigation"
    app:sliderType="slideRotate"
    tools:context=".activity.MainActivity"
    tools:ignore="ContentDescription">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/transparent"
        app:strokeWidth="0dp">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment_main"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_graph" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_16"
            app:cardCornerRadius="@dimen/dp_50"
            app:cardElevation="5dp"
            app:layout_behavior="com.google.android.material.behavior.HideViewOnScrollBehavior"
            app:strokeColor="@color/transparent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/floating_bottom_nav_bg"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/margin_tiny">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nav_landing"
                    style="?attr/materialIconButtonFilledStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tooltipText="@string/fragment_landing"
                    app:icon="@drawable/ic_home"
                    app:iconSize="@dimen/dp_28"
                    app:iconTint="@color/bottom_nav_button_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/btn_nav_category"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:targetApi="26" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nav_category"
                    style="?attr/materialIconButtonFilledStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:tooltipText="@string/fragment_category"
                    app:icon="@drawable/ic_list_order"
                    app:iconSize="@dimen/dp_28"
                    app:iconTint="@color/bottom_nav_button_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/btn_nav_landing"
                    app:layout_constraintRight_toLeftOf="@+id/btn_nav_promotion"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:targetApi="26" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nav_promotion"
                    style="?attr/materialIconButtonFilledStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:tooltipText="@string/fragment_promotion"
                    app:icon="@drawable/ic_promotion"
                    app:iconSize="@dimen/dp_28"
                    app:iconTint="@color/bottom_nav_button_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/btn_nav_category"
                    app:layout_constraintRight_toLeftOf="@+id/btn_nav_foreign"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:targetApi="26" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nav_foreign"
                    style="?attr/materialIconButtonFilledStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:tooltipText="@string/fragment_foreign"
                    app:icon="@drawable/ic_globe"
                    app:iconSize="@dimen/dp_28"
                    app:iconTint="@color/bottom_nav_button_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/btn_nav_promotion"
                    app:layout_constraintRight_toLeftOf="@+id/btn_nav_profile"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:targetApi="26" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nav_profile"
                    style="?attr/materialIconButtonFilledStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tooltipText="@string/fragment_profile"
                    app:icon="@drawable/ic_user"
                    app:iconSize="@dimen/dp_28"
                    app:iconTint="@color/bottom_nav_button_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/btn_nav_foreign"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:targetApi="26" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </com.google.android.material.card.MaterialCardView>


    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_main"
        android:layout_width="@dimen/nav_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/transparent"
        app:headerLayout="@layout/nav_header"
        app:itemHorizontalPadding="@dimen/margin_very_extra_large"
        app:itemIconSize="@dimen/dp_24"
        app:itemIconTint="@color/white"
        app:itemTextAppearance="@style/NavigationDrawerTextStyle"
        app:itemTextColor="@color/white"
        app:itemVerticalPadding="@dimen/margin_extra_small"
        app:menu="@menu/nav_menu">

        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="@dimen/nav_logo_image_size"
            android:layout_height="@dimen/nav_logo_image_size"
            android:layout_gravity="bottom|left"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_marginBottom="@dimen/dp_10"
            android:alpha="0.3"
            android:src="@drawable/ic_logo"
            app:tint="@color/white"
            tools:ignore="ContentDescription,RtlHardcoded" />

    </com.google.android.material.navigation.NavigationView>

</com.chonsu.ecommerce.common.views.MIDrawerView>