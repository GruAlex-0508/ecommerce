<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_shipping_dialog">

    <!-- Header -->
    <TextView
        android:id="@+id/tvShippingAddressTitle"
        android:layout_width="match_parent"
        android:layout_height="101dp"
        android:gravity="center"
        android:text="@string/shipping_address"
        android:textColor="@color/building_primary"
        android:textSize="?attr/text_size_28"
        android:includeFontPadding="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:background="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_28">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shipping_add_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="?attr/text_size_22"
            android:includeFontPadding="false" />

        <EditText
            android:id="@+id/etShippingTitle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_shipping_edit_text"
            android:hint="@string/shipping_add_info"
            android:paddingHorizontal="@dimen/dp_14"
            android:textColor="?attr/colorPrimary"
            android:textSize="?attr/text_size_14"
            android:singleLine="true"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_28"
            android:text="@string/shipping_add_address"
            android:textColor="?attr/colorPrimary"
            android:textSize="?attr/text_size_22"
            android:includeFontPadding="false" />

        <EditText
            android:id="@+id/etShippingAddress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_140"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_shipping_edit_text"
            android:gravity="top|start"
            android:hint="@string/shipping_add_info"
            android:paddingHorizontal="@dimen/dp_14"
            android:paddingVertical="@dimen/dp_12"
            android:textColor="?attr/colorPrimary"
            android:textSize="?attr/text_size_14"
            android:inputType="textCapSentences|textMultiLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_28"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShippingNo"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_56"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/shipping_btn_no"
                android:textAllCaps="false"
                android:textColor="?attr/colorPrimary"
                android:textSize="?attr/text_size_24"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="28dp"
                app:strokeColor="?attr/colorPrimary"
                app:rippleColor="?attr/colorTertiary"
                app:strokeWidth="@dimen/dp_1"
                app:elevation="@dimen/dp_4" />

            <Space
                android:layout_width="@dimen/dp_28"
                android:layout_height="@dimen/dp_1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShippingYes"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_56"
                android:layout_weight="1"
                android:text="@string/shipping_btn_yes"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="?attr/text_size_24"
                app:backgroundTint="?attr/colorPrimary"
                app:rippleColor="?attr/colorTertiary"
                app:cornerRadius="@dimen/dp_28"
                app:strokeWidth="0dp"
                app:elevation="@dimen/dp_4" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>