<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="wrap_content"
    android:layout_width="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:backgroundTint="@color/transparent"
    android:foreground="@drawable/bg_ripple">

    <LinearLayout
        android:layout_width="@dimen/dp_80"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_4"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/img_category_circle"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="@drawable/bg_category_circle"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/category_circle"
            android:contentDescription="Category image" />

        <TextView
            android:id="@+id/txt_category_circle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Furniture"
            android:textColor="?attr/colorPrimary"
            android:textSize="?attr/text_size_12" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>