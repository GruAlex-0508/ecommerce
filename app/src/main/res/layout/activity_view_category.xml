<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    tools:context=".activity.ViewCategoryActivity">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategoryProducts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_20"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:elevation="@dimen/dp_6">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbarCategory"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_220"
            android:background="@color/white"
            app:contentScrim="@color/white"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:statusBarScrim="@color/white"
            app:titleEnabled="false">

            <LinearLayout
                android:id="@+id/layoutCategoryScrollableHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.7">

                <LinearLayout
                    android:id="@+id/layoutCategoryHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_52"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dp_20"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingBottom="@dimen/dp_8">

                    <ImageButton
                        android:id="@+id/btnCategoryBack"
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        android:background="@android:color/transparent"
                        android:foreground="@drawable/bg_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_back_arrow"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tvCategoryHeaderTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/fragment_category"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="?attr/text_size_20"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnCategoryCart"
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        android:background="@color/transparent"
                        android:foreground="@drawable/bg_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/fragment_landing_ic_cart"
                        android:src="@drawable/ic_landing_cart"
                        app:tint="?attr/colorPrimary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:background="?attr/colorPrimary" />

                <LinearLayout
                    android:id="@+id/layoutProductInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_20"
                    android:layout_marginTop="@dimen/dp_10"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProductLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/fragment_category_products"
                        android:textColor="@color/building_primary"
                        android:textSize="?attr/text_size_20" />

                    <TextView
                        android:id="@+id/tvProductCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@null"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="?attr/text_size_16" />

                </LinearLayout>

            </LinearLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarCategorySearch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_76"
                android:layout_gravity="bottom"
                android:layout_marginTop="@dimen/dp_20"
                android:background="@color/white"
                android:paddingHorizontal="@dimen/dp_20"
                app:layout_collapseMode="pin">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSearch"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_56"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:layout_marginHorizontal="@dimen/dp_20"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/dp_28"
                    app:cardElevation="@dimen/dp_6"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/dp_18"
                        android:paddingEnd="@dimen/dp_12">

                        <ImageView
                            android:layout_width="@dimen/dp_28"
                            android:layout_height="@dimen/dp_28"
                            android:src="@drawable/ic_search"
                            app:tint="?attr/colorPrimary" />

                        <EditText
                            android:id="@+id/etCategorySearch"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/dp_10"
                            android:background="@android:color/transparent"
                            android:hint="@string/fragment_landing_ic_search"
                            android:singleLine="true"
                            android:textColor="?attr/colorPrimary"
                            android:textColorHint="?attr/colorPrimary"
                            android:textSize="?attr/text_size_14" />

                        <ImageButton
                            android:id="@+id/btn_landing_clear"
                            android:layout_width="@dimen/dp_40"
                            android:layout_height="@dimen/dp_40"
                            android:background="@drawable/bg_ripple"
                            android:clickable="true"
                            android:contentDescription="@string/fragment_landing_clear_search"
                            android:focusable="true"
                            android:padding="@dimen/dp_10"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_clear"
                            android:visibility="gone"
                            app:tint="?attr/colorPrimary" />

                        <View
                            android:layout_width="@dimen/dp_1"
                            android:layout_height="@dimen/dp_30"
                            android:layout_marginStart="@dimen/dp_10"
                            android:background="?attr/colorPrimary" />

                        <ImageButton
                            android:id="@+id/btn_camera"
                            android:layout_width="@dimen/dp_50"
                            android:layout_height="@dimen/dp_50"
                            android:background="@drawable/bg_ripple"
                            android:clickable="true"
                            android:contentDescription="@string/fragment_landing_clear_search"
                            android:focusable="true"
                            android:padding="@dimen/dp_10"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_camera"
                            app:tint="?attr/colorPrimary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>