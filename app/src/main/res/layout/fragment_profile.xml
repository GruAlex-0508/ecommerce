<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp_96">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_390"
            android:background="@drawable/bg_profile_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="@dimen/dp_54"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/dp_180"
                    android:layout_height="@dimen/dp_180"
                    app:cardCornerRadius="@dimen/dp_24"
                    app:cardElevation="@dimen/dp_4"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="@dimen/dp_1">

                    <ImageView
                        android:id="@+id/imgProfileAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Profile picture"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_avatar" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_14"
                    android:text="@string/profile_username"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="?attr/text_size_24"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfilePhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:text="@string/profile_cid"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="?attr/text_size_22" />

            </LinearLayout>
        </FrameLayout>

        <!-- Order progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_20"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/layoutOrderStep1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dp_10"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_apply" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_applying"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="?attr/text_size_14" />
            </LinearLayout>


            <View
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_2"
                android:layout_marginTop="-14dp"
                android:background="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/layoutOrderStep2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dp_10"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_received" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_received"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="?attr/text_size_14" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_2"
                android:layout_marginTop="-14dp"
                android:background="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/layoutOrderStep3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dp_10"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_transfer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_transfer"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="?attr/text_size_14" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_2"
                android:layout_marginTop="-14dp"
                android:background="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/layoutOrderStep4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dp_10"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_completed" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_completed"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="?attr/text_size_14" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_2"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginHorizontal="@dimen/dp_20"
            android:background="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_20"
            android:text="Account"
            android:textColor="?attr/colorPrimary"
            android:textSize="?attr/text_size_18"
            android:textStyle="bold"/>

        <include
            android:id="@+id/rowSettings"
            layout="@layout/item_profile_menu" />

        <include
            android:id="@+id/rowNotification"
            layout="@layout/item_profile_menu" />

        <include
            android:id="@+id/rowOrderHistory"
            layout="@layout/item_profile_menu"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_20"
            android:text="Account"
            android:textColor="?attr/colorPrimary"
            android:textSize="?attr/text_size_18"
            android:textStyle="bold"/>

        <include
            android:id="@+id/rowPrivacy"
            layout="@layout/item_profile_menu" />

        <include
            android:id="@+id/rowAddress"
            layout="@layout/item_profile_menu" />

        <include
            android:id="@+id/rowLogout"
            layout="@layout/item_profile_menu" />

    </LinearLayout>
</ScrollView>
