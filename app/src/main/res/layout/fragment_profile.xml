<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="@dimen/dp_110"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: curved background + avatar / name / phone -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_270"
            android:clipChildren="false">

            <com.chonsu.ecommerce.common.views.ProfileHeaderView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="@dimen/dp_34"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/dp_120"
                    android:layout_height="@dimen/dp_120"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/dp_20"
                    app:cardElevation="@dimen/dp_6"
                    app:strokeColor="@color/white"
                    app:strokeWidth="@dimen/dp_1">

                    <ImageView
                        android:id="@+id/imgProfileAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/profile_avatar_description"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_avatar" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/profile_username"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="?attr/text_size_20"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfilePhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:text="@string/profile_cid"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="?attr/text_size_18" />

            </LinearLayout>
        </FrameLayout>

        <!-- Order progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_8"
            android:clipChildren="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/stepApplying"
                layout="@layout/item_profile_order_step"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <View
                android:layout_width="@dimen/dp_50"
                android:layout_height="@dimen/dp_2"
                android:layout_marginTop="@dimen/dp_18"
                android:background="?attr/colorPrimary" />

            <include
                android:id="@+id/stepReceived"
                layout="@layout/item_profile_order_step"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <View
                android:layout_width="@dimen/dp_50"
                android:layout_height="@dimen/dp_2"
                android:layout_marginTop="@dimen/dp_18"
                android:background="?attr/colorPrimary" />

            <include
                android:id="@+id/stepTransfer"
                layout="@layout/item_profile_order_step"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <View
                android:layout_width="@dimen/dp_50"
                android:layout_height="@dimen/dp_2"
                android:layout_marginTop="@dimen/dp_18"
                android:background="?attr/colorPrimary" />

            <include
                android:id="@+id/stepCompleted"
                layout="@layout/item_profile_order_step"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_2"
            android:layout_marginHorizontal="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_12"
            android:background="?attr/colorPrimary" />

        <!-- Sections + rows (ProfileMenuAdapter) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProfileMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
