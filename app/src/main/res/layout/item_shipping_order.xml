<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_10">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_20"
        android:background="@color/transparent"
        app:cardCornerRadius="@dimen/dp_20"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="@dimen/dp_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_160"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dp_140"
                android:layout_height="@dimen/dp_120"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/dp_20"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="@dimen/dp_10"
                app:cardElevation="@dimen/dp_4"
                app:strokeWidth="0dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/dp_130"
                    android:layout_height="@dimen/dp_110"
                    android:layout_gravity="center"
                    android:elevation="0dp"
                    app:cardCornerRadius="@dimen/dp_10"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/order_image"
                        android:layout_width="@dimen/dp_140"
                        android:layout_height="@dimen/dp_140"
                        android:layout_gravity="center"
                        android:contentDescription="@string/content_description"
                        android:src="@drawable/item_img" />

                </com.google.android.material.card.MaterialCardView>


            </com.google.android.material.card.MaterialCardView>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/dp_16"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/order_name"
                    android:layout_width="@dimen/dp_100"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/shipping_title_home"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="?attr/text_size_22"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/order_size"
                    android:layout_width="@dimen/dp_100"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:maxLines="1"
                    android:text="@string/shipping_title_size"
                    android:textColor="@color/car_secondary"
                    android:textSize="?attr/text_size_16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/order_price"
                    android:layout_width="@dimen/dp_100"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:maxLines="1"
                    android:text="@string/shipping_title_price"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="?attr/text_size_28"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="20dp"
                android:backgroundTint="@color/transparent"
                app:cardCornerRadius="@dimen/dp_20"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="@dimen/dp_1">

                <TextView
                    android:id="@+id/order_amount"
                    android:layout_width="@dimen/dp_70"
                    android:layout_height="@dimen/dp_40"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/shipping_title_amount"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="?attr/text_size_16" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>